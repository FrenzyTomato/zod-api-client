{
  "name": "zod-api-client",
  "version": "0.3.0",
  "description": "Generate Zod schemas and typed API clients from OpenAPI, Swagger, Postman or HAR files.",
  "keywords": [
    "openapi",
    "swagger",
    "postman",
    "har",
    "zod",
    "playwright",
    "axios",
    "api-client",
    "codegen"
  ],
  "license": "MIT",
  "author": {
    "name": "Sinclair Liang",
    "url": "https://github.com/FrenzyTomato"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrenzyTomato/zod-api-client.git"
  },
  "homepage": "https://github.com/FrenzyTomato/zod-api-client#readme",
  "bugs": {
    "url": "https://github.com/FrenzyTomato/zod-api-client/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime/index.d.ts",
        "default": "./dist/runtime/index.js"
      },
      "require": {
        "types": "./dist/runtime/index.d.cts",
        "default": "./dist/runtime/index.cjs"
      }
    }
  },
  "bin": {
    "zod-api-client": "dist/cli/index.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@apiture/openapi-down-convert": "^0.14.2",
    "jiti": "^2.7.0",
    "prettier": "^3.6.2",
    "swagger2openapi": "^7.0.8",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.58.0 <2",
    "zod": ">=4.4.3 <5"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^18.19.120",
    "axios": "^1.21.0",
    "openapi-types": "^12.1.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "zod": "4.4.3"
  }
}
